# Copy to .env at repo root. NEVER commit .env.

# --- Nebius Token Factory (required for live runs) ---
TOKEN_FACTORY_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=

# Model IDs, confirm with `python scripts/day0_test.py` (GET /v1/models) and paste exact IDs.
# Listed for Token Factory as of Oct 2026 (third-party listings; verify casing on your account):
#   nvidia/Nemotron-3_5-Lightning            fast + cheap, $0.06 / $0.24 per 1M tokens
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B    fast alternative, same price
#   nvidia/Nemotron-3-Nano-Omni              vision (screenshots), $0.06 / $0.24
#   nvidia/nemotron-3-super-120b-a12b        agent (persona decisions), $0.30 / $0.90
#   nvidia/Nemotron-3-Ultra-550b-a55b        reasoning (final report), $1.00 / $3.00
NEMOTRON_FAST=
NEMOTRON_VISION=
NEMOTRON_AGENT=
NEMOTRON_REASON=

# Send chat_template_kwargs.enable_thinking=false on fast/vision/agent calls (Ultra keeps thinking).
# If the endpoint rejects it, the client turns it off by itself.
NEMOTRON_THINKING_OFF=true

# Optional price overrides (USD per 1M tokens, "input,output") if list prices change.
# PRICE_AGENT=0.30,0.90

# --- Tavily (persona research + competitor references; Best Use of Tavily bonus) ---
TAVILY_API_KEY=

# --- Guard ---
BUDGET_USD_SOFT=30
BUDGET_USD_HARD=40
RATE_LIMIT_PER_HOUR=2
RATE_LIMIT_PER_DAY=5
MAX_CONCURRENT_RUNS=2
# Judges send header X-FiveUsers-Key: <token> to skip the rate limit (not the budget cap).
JUDGE_TOKEN=change-me-long-random

# --- Runtime ---
DATA_DIR=./data
MAX_PERSONAS=5
MAX_STEPS_PER_PERSONA=16
# All five lanes go live together; drop to 3 if the host runs out of memory.
WALKER_CONCURRENCY=5
ALLOWED_ORIGINS=http://localhost:3000

# Local development only:
#   DRY_RUN=true            scripted personas, no model calls, no credits (reports are marked "dry run")
#   ALLOW_PRIVATE_URLS=true lets the test browser open localhost (needed for the local sample sites)
DRY_RUN=false
ALLOW_PRIVATE_URLS=false

# --- Web (web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:7860
